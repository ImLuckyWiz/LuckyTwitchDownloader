"{error}"
msgstr ""
"Windows no aceptó la configuración:\n"
"{error}"

#: qt_ui/tabs/options.py
msgid "auto threshold"
msgstr "umbral automático"

#: qt_ui/tabs/options.py
msgid "download threads, file and folder names"
msgstr "hilos de descarga, nombres de archivos y carpetas"

#: qt_ui/tabs/options.py
msgid "file format, embedded emotes and how the overlay looks"
msgstr "formato de archivo, emoticonos incrustados y apariencia de la superposición de chat"

#: qt_ui/tabs/options.py
msgid ""
"m4a keeps Twitch's own audio exactly as it is (no re-encoding). mp3 converts it with ffmpeg (192 "
"kbit/s) and plays everywhere."
msgstr ""
"m4a mantiene el audio propio de Twitch tal cual (sin recodificar). mp3 lo convierte con ffmpeg "
"(192 kbit/s) y se reproduce en todas partes."

#: qt_ui/tabs/options.py
msgid ""
"macOS sends these links to the app by itself once it is in Applications. If a link does nothing, "
