{
  "manifestVersion": 5,
  "id": "com.luckytwitch.premiere-markers",
  "name": "LuckyTwitch Markers",
  "version": "0.5.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "luckytwitchMarkers",
      "label": { "default": "LuckyTwitch Markers" },
      "minimumSize": { "width": 280, "height": 320 },
      "preferredDockedSize": { "width": 320, "height": 560 },
      "preferredFloatingSize": { "width": 340, "height": 600 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite"
  }
}
